{
  "$schema-note": "design/office 新增 token；其餘沿用 design/unify/tokens.json。名字與值必須與 DESIGN-SYSTEM.md 一致。",
  "color": {
    "scene-sky": {
      "cssVar": "--scene-sky",
      "light": "#f5f6fe",
      "dark": "#161935"
    },
    "scene-floor": {
      "cssVar": "--scene-floor",
      "light": "#dfe3f5",
      "dark": "#2a2e5a"
    },
    "scene-floor-edge": {
      "cssVar": "--scene-floor-edge",
      "light": "#c3c9e8",
      "dark": "#1a1d3d"
    },
    "scene-zone": {
      "cssVar": "--scene-zone",
      "light": "#d3d9f1",
      "dark": "#323668"
    },
    "scene-zone-edge": {
      "cssVar": "--scene-zone-edge",
      "light": "#b6bde2",
      "dark": "#15183a"
    },
    "scene-lounge": {
      "cssVar": "--scene-lounge",
      "light": "#ece6fb",
      "dark": "#332f63"
    },
    "scene-wall-l": {
      "cssVar": "--scene-wall-l",
      "light": "#ffffff",
      "dark": "#363b74"
    },
    "scene-wall-r": {
      "cssVar": "--scene-wall-r",
      "light": "#e9ecf9",
      "dark": "#2b2f62"
    },
    "scene-wall-top": {
      "cssVar": "--scene-wall-top",
      "light": "#c9cee9",
      "dark": "#454b8c"
    },
    "scene-window": {
      "cssVar": "--scene-window",
      "light": "#cfe0ff",
      "dark": "#0e1130"
    },
    "scene-desk": {
      "cssVar": "--scene-desk",
      "light": "#f3e7d5",
      "dark": "#4c4675"
    },
    "scene-desk-side": {
      "cssVar": "--scene-desk-side",
      "light": "#dccaae",
      "dark": "#3b3660"
    },
    "scene-monitor": {
      "cssVar": "--scene-monitor",
      "light": "#2b2e4c",
      "dark": "#1a1c33"
    },
    "scene-screen-off": {
      "cssVar": "--scene-screen-off",
      "light": "#4a4f78",
      "dark": "#2c2f52"
    },
    "scene-screen-on": {
      "cssVar": "--scene-screen-on",
      "light": "#a9c6ff",
      "dark": "#7fa6ff"
    },
    "scene-couch": {
      "cssVar": "--scene-couch",
      "light": "#c4bdf0",
      "dark": "#5a5296"
    },
    "scene-plant": {
      "cssVar": "--scene-plant",
      "light": "#8fb8a5",
      "dark": "#4f7f6c"
    },
    "scene-shadow": {
      "cssVar": "--scene-shadow",
      "light": "rgb(61 67 128 / 12%)",
      "dark": "rgb(5 6 20 / 40%)"
    }
  },
  "substate": {
    "waiting": {
      "label": "等你",
      "tone": "danger",
      "icon": "Hand",
      "marker": "alert",
      "paneStatus": "blocked",
      "order": 1
    },
    "error": {
      "label": "錯誤",
      "tone": "danger",
      "icon": "CircleAlert",
      "marker": "alert",
      "paneStatus": "blocked",
      "order": 2
    },
    "interrupted": {
      "label": "中斷",
      "tone": "warn",
      "icon": "Square",
      "marker": "soft",
      "paneStatus": "idle",
      "order": 3
    },
    "running": {
      "label": "執行",
      "tone": "ok",
      "icon": "Terminal",
      "marker": "line",
      "paneStatus": "working",
      "order": 4
    },
    "writing": {
      "label": "回覆中",
      "tone": "ok",
      "icon": "PencilLine",
      "marker": "line",
      "paneStatus": "working",
      "order": 5
    },
    "thinking": {
      "label": "思考中",
      "tone": "ok",
      "icon": null,
      "marker": "bubble",
      "paneStatus": "working",
      "order": 6
    },
    "done": {
      "label": "完成",
      "tone": "ok",
      "icon": "Check",
      "marker": "soft",
      "paneStatus": "done",
      "order": 7
    },
    "idle": {
      "label": "閒置",
      "tone": "idle",
      "icon": "Moon",
      "marker": "soft-hidden",
      "paneStatus": "idle",
      "order": 8
    }
  },
  "substateTiming": {
    "doneToIdleMin": 10,
    "interruptedToIdleMin": 10,
    "offDutyAfterIdleMin": 120
  },
  "floorRing": {
    "ring-alert": {
      "inner": 0.62,
      "outer": 0.95,
      "line": 0.06,
      "color": "status-danger",
      "fillAlpha": 0.14,
      "outerAlpha": 0.4
    },
    "ring-select": {
      "radius": 0.62,
      "line": 0.1,
      "color": "ring"
    },
    "screen-glow": {
      "radius": 1.1,
      "color": "scene-screen-on",
      "alpha": 0.16,
      "theme": "dark"
    }
  },
  "light": {
    "light": {
      "hemi": {
        "sky": "#ffffff",
        "ground": "scene-floor",
        "intensity": 0.9
      },
      "key": {
        "color": "#fff4e5",
        "intensity": 1.2,
        "position": [
          -5,
          10,
          4
        ],
        "shadowMap": 1024
      },
      "screenEmissive": 0.4
    },
    "dark": {
      "hemi": {
        "sky": "#8fa8ff",
        "ground": "#1a1d3d",
        "intensity": 0.35
      },
      "key": {
        "color": "#b9c6ff",
        "intensity": 0.4,
        "position": [
          -5,
          10,
          4
        ],
        "shadowMap": 1024
      },
      "screenEmissive": 0.9
    }
  },
  "size": {
    "marker-h": {
      "px": 24,
      "tailwind": "h-marker",
      "alias": "pill"
    },
    "marker-alert-h": {
      "px": 28,
      "tailwind": "h-marker-alert",
      "alias": "control-sm"
    },
    "marker-pointer": {
      "px": [
        10,
        6
      ]
    },
    "hovercard-w": {
      "px": 280,
      "tailwind": "w-hovercard"
    },
    "overlay-w": {
      "px": 288,
      "alias": "sidebar-w(xl)"
    }
  },
  "motion": {
    "motion-alert-pulse": {
      "ms": 1600,
      "scale": [
        1,
        1.25
      ],
      "opacity": [
        0.4,
        0
      ]
    },
    "motion-think-dots": {
      "ms": 1200
    },
    "motion-camera-fly": {
      "ms": 600,
      "easing": "ease-out"
    },
    "motion-walk": {
      "cellsPerSec": 1.2
    },
    "theme-lerp": {
      "ms": 400
    }
  },
  "scene": {
    "cell": "1m",
    "room": [
      20,
      14
    ],
    "wallH": 2.4,
    "projectZone": [
      9.2,
      6.6
    ],
    "frontZone": [
      9.2,
      5.6
    ],
    "leadDesk": [
      1.9,
      1.0
    ],
    "desk": [
      1.4,
      0.8
    ],
    "podMaxCols": 4,
    "camera": {
      "azimuth": 45,
      "elevation": 35,
      "fov": 30,
      "elevationRange": [
        20,
        70
      ],
      "distanceRange": [
        0.4,
        1.6
      ]
    },
    "tiers": {
      "small": 12,
      "medium": 40,
      "zonesPerFloor": 6
    }
  }
}