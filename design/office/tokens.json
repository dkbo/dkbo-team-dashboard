{
  "$schema-note": "design/office 新增 token；其餘沿用 design/unify/tokens.json。名字與值必須與 DESIGN-SYSTEM.md 一致。",
  "color": {
    "scene-sky": {
      "cssVar": "--scene-sky",
      "light": "#f5f6fe",
      "dark": "#161935"
    },
    "scene-floor": {
      "cssVar": "--scene-floor",
      "light": "#dfe3f5",
      "dark": "#2a2e5a"
    },
    "scene-floor-edge": {
      "cssVar": "--scene-floor-edge",
      "light": "#c3c9e8",
      "dark": "#1a1d3d"
    },
    "scene-zone": {
      "cssVar": "--scene-zone",
      "light": "#d3d9f1",
      "dark": "#323668"
    },
    "scene-zone-edge": {
      "cssVar": "--scene-zone-edge",
      "light": "#b6bde2",
      "dark": "#15183a"
    },
    "scene-lounge": {
      "cssVar": "--scene-lounge",
      "light": "#ece6fb",
      "dark": "#332f63"
    },
    "scene-wall-l": {
      "cssVar": "--scene-wall-l",
      "light": "#ffffff",
      "dark": "#363b74"
    },
    "scene-wall-r": {
      "cssVar": "--scene-wall-r",
      "light": "#e9ecf9",
      "dark": "#2b2f62"
    },
    "scene-wall-top": {
      "cssVar": "--scene-wall-top",
      "light": "#c9cee9",
      "dark": "#454b8c"
    },
    "scene-window": {
      "cssVar": "--scene-window",
      "light": "#cfe0ff",
      "dark": "#0e1130"
    },
    "scene-desk": {
      "cssVar": "--scene-desk",
      "light": "#f3e7d5",
      "dark": "#4c4675"
    },
    "scene-desk-side": {
      "cssVar": "--scene-desk-side",
      "light": "#dccaae",
      "dark": "#3b3660"
    },
    "scene-monitor": {
      "cssVar": "--scene-monitor",
      "light": "#2b2e4c",
      "dark": "#1a1c33"
    },
    "scene-screen-off": {
      "cssVar": "--scene-screen-off",
      "light": "#4a4f78",
      "dark": "#2c2f52"
    },
    "scene-screen-on": {
      "cssVar": "--scene-screen-on",
      "light": "#a9c6ff",
      "dark": "#7fa6ff"
    },
    "scene-couch": {
      "cssVar": "--scene-couch",
      "light": "#c4bdf0",
      "dark": "#5a5296"
    },
    "scene-plant": {
      "cssVar": "--scene-plant",
      "light": "#8fb8a5",
      "dark": "#4f7f6c"
    },
    "scene-shadow": {
      "cssVar": "--scene-shadow",
      "light": "rgb(61 67 128 / 12%)",
      "dark": "rgb(5 6 20 / 40%)"
    },
    "scene-cabinet": {
      "cssVar": "--scene-cabinet",
      "light": "#e4e7f4",
      "dark": "#4a4f86",
      "use": "櫃子、白板框、電表箱頂面"
    },
    "scene-cabinet-side": {
      "cssVar": "--scene-cabinet-side",
      "light": "#cdd2ea",
      "dark": "#3a3e70",
      "use": "櫃子側面"
    },
    "scene-board": {
      "cssVar": "--scene-board",
      "light": "#ffffff",
      "dark": "#c9cdea",
      "use": "白板面（正常）"
    },
    "scene-cork": {
      "cssVar": "--scene-cork",
      "light": "#e2c9a0",
      "dark": "#6b5a73",
      "use": "公告板軟木"
    },
    "scene-lamp-off": {
      "cssVar": "--scene-lamp-off",
      "light": "#8a8fb3",
      "dark": "#3a3e66",
      "use": "燈號熄滅（git 櫃燈、電表斷路燈）"
    },
    "rank-senior": {
      "cssVar": "--rank-senior",
      "light": "#3f3a9e",
      "dark": "#5a52d0",
      "use": "資深襯衫／職等色點",
      "label": "資深"
    },
    "rank-mid": {
      "cssVar": "--rank-mid",
      "light": "#5b8cff",
      "dark": "#6f9bff",
      "use": "中階",
      "label": "中階"
    },
    "rank-junior": {
      "cssVar": "--rank-junior",
      "light": "#a9d8f5",
      "dark": "#b4dcf8",
      "use": "初階",
      "label": "初階"
    },
    "rank-visitor": {
      "cssVar": "--rank-visitor",
      "light": "#cfd2dd",
      "dark": "#d6d8e2",
      "use": "訪客（另掛白色識別證）",
      "label": "訪客"
    },
    "effort-star": {
      "alias": "accent-foreground",
      "emptyOpacity": 0.22
    }
  },
  "substate": {
    "waiting": {
      "label": "等你",
      "tone": "danger",
      "icon": "Hand",
      "marker": "alert",
      "paneStatus": "blocked",
      "order": 1
    },
    "error": {
      "label": "錯誤",
      "tone": "danger",
      "icon": "CircleAlert",
      "marker": "alert",
      "paneStatus": "blocked",
      "order": 2
    },
    "interrupted": {
      "label": "中斷",
      "tone": "warn",
      "icon": "Square",
      "marker": "soft",
      "paneStatus": "idle",
      "order": 3
    },
    "running": {
      "label": "執行",
      "tone": "ok",
      "icon": "Terminal",
      "marker": "line",
      "paneStatus": "working",
      "order": 4
    },
    "writing": {
      "label": "回覆中",
      "tone": "ok",
      "icon": "PencilLine",
      "marker": "line",
      "paneStatus": "working",
      "order": 5
    },
    "thinking": {
      "label": "思考中",
      "tone": "ok",
      "icon": null,
      "marker": "bubble",
      "paneStatus": "working",
      "order": 6
    },
    "done": {
      "label": "完成",
      "tone": "ok",
      "icon": "Check",
      "marker": "soft",
      "paneStatus": "done",
      "order": 7
    },
    "idle": {
      "label": "閒置",
      "tone": "idle",
      "icon": "Moon",
      "marker": "soft-hidden",
      "paneStatus": "idle",
      "order": 8
    }
  },
  "substateTiming": {
    "doneToIdleMin": 10,
    "interruptedToIdleMin": 10,
    "offDutyAfterIdleMin": 120
  },
  "floorRing": {
    "ring-alert": {
      "inner": 0.62,
      "outer": 0.95,
      "line": 0.06,
      "color": "status-danger",
      "fillAlpha": 0.14,
      "outerAlpha": 0.4
    },
    "ring-select": {
      "radius": 0.62,
      "line": 0.1,
      "color": "ring"
    },
    "screen-glow": {
      "radius": 1.1,
      "color": "scene-screen-on",
      "alpha": 0.16,
      "theme": "dark"
    }
  },
  "light": {
    "light": {
      "hemi": {
        "sky": "#ffffff",
        "ground": "scene-floor",
        "intensity": 0.9
      },
      "key": {
        "color": "#fff4e5",
        "intensity": 1.2,
        "position": [
          -5,
          10,
          4
        ],
        "shadowMap": 1024
      },
      "screenEmissive": 0.4
    },
    "dark": {
      "hemi": {
        "sky": "#8fa8ff",
        "ground": "#1a1d3d",
        "intensity": 0.35
      },
      "key": {
        "color": "#b9c6ff",
        "intensity": 0.4,
        "position": [
          -5,
          10,
          4
        ],
        "shadowMap": 1024
      },
      "screenEmissive": 0.9
    }
  },
  "size": {
    "marker-h": {
      "px": 24,
      "tailwind": "h-marker",
      "alias": "pill"
    },
    "marker-alert-h": {
      "px": 28,
      "tailwind": "h-marker-alert",
      "alias": "control-sm"
    },
    "marker-pointer": {
      "px": [
        10,
        6
      ]
    },
    "hovercard-w": {
      "px": 280,
      "tailwind": "w-hovercard"
    },
    "overlay-w": {
      "px": 288,
      "alias": "sidebar-w(xl)"
    },
    "effort-star": {
      "px": 8
    },
    "effort-stars-h": {
      "px": 14,
      "gapToMarker": 3
    },
    "object-label-h": {
      "px": 28,
      "alias": "control-sm"
    },
    "board-label-w": {
      "px": 200
    },
    "board-label-bar-h": {
      "px": 6,
      "gap": 3
    },
    "event-badge": {
      "px": 20,
      "offset": [
        -9,
        -9
      ]
    },
    "event-bubble-h": {
      "px": 24,
      "alias": "pill"
    },
    "finder-w": {
      "px": 304
    },
    "object-label-dot": {
      "px": 12,
      "tw": "size-3",
      "note": "ObjectLabel yielded dot (E2)"
    }
  },
  "motion": {
    "motion-alert-pulse": {
      "ms": 1600,
      "scale": [
        1,
        1.25
      ],
      "opacity": [
        0.4,
        0
      ]
    },
    "motion-think-dots": {
      "ms": 1200
    },
    "motion-camera-fly": {
      "ms": 600,
      "easing": "ease-out"
    },
    "motion-walk": {
      "cellsPerSec": 1.2
    },
    "theme-lerp": {
      "ms": 400
    },
    "motion-event-bubble": {
      "ms": 3000,
      "reducedMs": 6000
    },
    "motion-badge-pop": {
      "ms": 300,
      "scale": [
        0,
        1.15,
        1
      ]
    },
    "motion-wave-fill": {
      "ms": 600
    },
    "motion-spark": {
      "ms": 1200
    },
    "motion-thumb": {
      "ms": 1500
    },
    "motion-head-down": {
      "ms": 2000
    },
    "motion-celebrate": {
      "ms": 3000,
      "jumps": 2
    },
    "review-walk-max": {
      "ms": 4000
    },
    "event-live-window": {
      "ms": 10000
    },
    "cluster-dissolve-after-close": {
      "min": 10
    }
  },
  "scene": {
    "cell": "1m",
    "room": [
      24.4,
      14
    ],
    "wallH": 2.4,
    "projectZone": [
      9.2,
      6.6
    ],
    "frontZone": [
      9.2,
      5.6
    ],
    "leadDesk": [
      1.9,
      1.0
    ],
    "desk": [
      1.4,
      0.8
    ],
    "podMaxCols": 4,
    "camera": {
      "azimuth": 45,
      "elevation": 35,
      "fov": 30,
      "elevationRange": [
        20,
        70
      ],
      "distanceRange": [
        0.4,
        1.6
      ]
    },
    "tiers": {
      "small": 12,
      "medium": 40,
      "zonesPerFloor": 6
    },
    "lobby": {
      "x": [
        20,
        24.4
      ]
    },
    "objects": {
      "whiteboard": {
        "page": "/p/:project/t/:dir",
        "offset": [
          0.2,
          5.6
        ],
        "size": [
          1.8,
          0.06,
          1.1
        ],
        "z": 0.6
      },
      "monitorWall": {
        "page": "/herdr",
        "x": [
          20.6,
          23.6
        ],
        "z": [
          0.9,
          2.1
        ],
        "grid": [
          3,
          2
        ]
      },
      "archive": {
        "page": "/history",
        "x": [
          20.5,
          23.9
        ],
        "y": 4.2,
        "size": [
          3.4,
          0.5,
          1.9
        ]
      },
      "gitCabinet": {
        "page": "/git",
        "at": [
          20.6,
          6.4
        ],
        "size": [
          0.8,
          0.6,
          1.2
        ]
      },
      "bulletin": {
        "page": "/",
        "at": [
          21.0,
          11.4
        ],
        "size": [
          1.6,
          0.06,
          1.0
        ]
      },
      "powerMeter": {
        "page": "/trends",
        "at": [
          14.0,
          8.4
        ],
        "size": [
          0.5,
          0.3,
          0.6
        ],
        "z": 0.85
      },
      "labelFullAtDistance": 0.8,
      "labelAlertOnlyBelow": 0.6,
      "labelDensity": {
        "decision": "E2（領導修正版）",
        "default": "compact",
        "compact": "icon + value；chip only when tone is danger|warn；TaskBoardLabel compact = icon + 'closed/planned'，no bar",
        "fullAtDistance": 0.8,
        "alertOnlyBelow": 0.6
      },
      "labelCollision": {
        "decision": "E2（領導修正版）",
        "rule": "ObjectLabel yields to character labels (AgentMarker, EffortStars, EventBadge): shrink to object-label-dot, hide if the dot still overlaps",
        "markerVsMarker": "lower priority shrinks to dot (8); priority = hovered/selected > substate priority §1.2",
        "alertMarkerYields": false,
        "defaultViewAcceptance": "no label overlaps another, none clipped by canvas edge or overlays (FinderPanel, StateCounts, Legend, ZoomControls)"
      }
    }
  },
  "rank": {
    "rules": [
      {
        "kind": "claude",
        "match": "^opus",
        "rank": "senior"
      },
      {
        "kind": "claude",
        "match": "^sonnet",
        "rank": "mid"
      },
      {
        "kind": "claude",
        "match": "^haiku",
        "rank": "junior"
      },
      {
        "kind": "codex",
        "match": "-(mini|nano)$",
        "rank": "junior"
      },
      {
        "kind": "codex",
        "match": "-codex-max$",
        "rank": "senior"
      },
      {
        "kind": "codex",
        "match": "-codex$",
        "rank": "mid"
      },
      {
        "kind": "codex",
        "match": "^gpt-[0-9.]+$",
        "rank": "senior"
      },
      {
        "kind": "*",
        "match": ".*",
        "rank": "visitor"
      }
    ],
    "note": "依序比對，第一個命中；讀不到 model＝visitor（decisions E10）"
  },
  "effort": {
    "low": 1,
    "medium": 2,
    "high": 3,
    "xhigh": 4,
    "max": 5,
    "minimal": 1,
    "unknown": 0,
    "visibility": {
      "decision": "E11（領導修正版）",
      "scene": "hover|selected only",
      "dom": "FinderPanel, AgentHoverCard, AgentDetailPane, list view always show stars"
    }
  },
  "perf": {
    "stack": "@react-three/fiber + @react-three/drei",
    "frameloop": "demand",
    "dpr": [
      1,
      2
    ],
    "dprWhileInteracting": 1,
    "hiddenTab": "never",
    "drawCallBudget40": 150,
    "modelBudgetMB": 1.5,
    "chunkBudgetKBgz": 250,
    "shadowMap": {
      "size": 1024,
      "autoUpdate": false
    }
  }
}
