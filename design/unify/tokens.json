{
  "$schema-note": "dkbo dashboard unify tokens. status: keep = index.css 既有、值不變；changed = 既有名、改值；new = 新增；alias = 新名指向既有 token；deprecated = 移轉後刪除。cssVar 是 index.css 的變數名，tailwind 是要用的 class 片段。",
  "color": {
    "base": {
      "background":         { "cssVar": "--background",         "tailwind": "bg-background",         "light": "#eef0fb", "dark": "#1e2142", "status": "keep" },
      "foreground":         { "cssVar": "--foreground",         "tailwind": "text-foreground",       "light": "#1d2045", "dark": "#eceeff", "status": "keep" },
      "card":               { "cssVar": "--card",               "tailwind": "bg-card",               "light": "#ffffff", "dark": "#282b55", "status": "keep" },
      "card-foreground":    { "cssVar": "--card-foreground",    "tailwind": "text-card-foreground",  "light": "#1d2045", "dark": "#eceeff", "status": "keep" },
      "popover":            { "cssVar": "--popover",            "tailwind": "bg-popover",            "light": "#ffffff", "dark": "#2e3260", "status": "keep" },
      "popover-foreground": { "cssVar": "--popover-foreground", "tailwind": "text-popover-foreground","light": "#1d2045", "dark": "#eceeff", "status": "keep" },
      "primary":            { "cssVar": "--primary",            "tailwind": "bg-primary",            "light": "#5b8cff", "dark": "#5b8cff", "status": "keep" },
      "primary-foreground": { "cssVar": "--primary-foreground", "tailwind": "text-primary-foreground","light": "#10163a", "dark": "#0f1433", "status": "keep" },
      "secondary":          { "cssVar": "--secondary",          "tailwind": "bg-secondary",          "light": "#f1edff", "dark": "#353a6e", "status": "keep" },
      "secondary-foreground":{ "cssVar": "--secondary-foreground","tailwind": "text-secondary-foreground","light": "#3d2c8a", "dark": "#e3e6ff", "status": "keep" },
      "muted":              { "cssVar": "--muted",              "tailwind": "bg-muted",              "light": "#f3f4fc", "dark": "#31356a", "status": "keep" },
      "muted-foreground":   { "cssVar": "--muted-foreground",   "tailwind": "text-muted-foreground", "light": "#565b82", "dark": "#aeb2dc", "status": "keep" },
      "accent":             { "cssVar": "--accent",             "tailwind": "bg-accent",             "light": "#ece8ff", "dark": "#3a3577", "status": "keep" },
      "accent-foreground":  { "cssVar": "--accent-foreground",  "tailwind": "text-accent-foreground","light": "#3d2c8a", "dark": "#e0d9ff", "status": "keep" },
      "destructive":        { "cssVar": "--destructive",        "tailwind": "text-destructive",      "light": "var(--status-danger-fg) = #c62a44", "dark": "var(--status-danger-fg) = #ff8a9a", "status": "alias", "note": "dark 由 #ff6b7f 改指向 status-danger-fg（#ff8a9a），對 card 由 4.89 升到 5.97" },
      "border":             { "cssVar": "--border",             "tailwind": "border-border",         "light": "#e2e5f5", "dark": "rgb(170 180 255 / 10%)", "status": "keep" },
      "input":              { "cssVar": "--input",              "tailwind": "border-input",          "light": "#d6daf0", "dark": "rgb(170 180 255 / 16%)", "status": "keep" },
      "ring":               { "cssVar": "--ring",               "tailwind": "ring-ring",             "light": "#7b5cff", "dark": "#7b5cff", "status": "keep" },
      "soft-shadow":        { "cssVar": "--soft-shadow",        "tailwind": "(shadow-soft / shadow-pop 內部用)", "light": "rgb(80 90 180 / 0.2)", "dark": "rgb(8 10 30 / 0.55)", "status": "keep" }
    },
    "brand": {
      "brand-blue":   { "cssVar": "--brand-blue",   "tailwind": "*-brand-blue",   "light": "#5b8cff", "dark": "#5b8cff", "status": "keep", "use": "導覽選中、圖示、裝飾、額度膠囊框" },
      "brand-violet": { "cssVar": "--brand-violet", "tailwind": "*-brand-violet", "light": "#7b5cff", "dark": "#7b5cff", "status": "keep", "use": "焦點環、info 狀態實心、裝飾" },
      "brand-coral":  { "cssVar": "--brand-coral",  "tailwind": "*-brand-coral",  "light": "#ff5a6e", "dark": "#ff5a6e", "status": "keep", "use": "只做裝飾（Logo 漸層），不當狀態色" }
    },
    "status": {
      "danger": {
        "meaning": "需要人立刻處理",
        "solid": { "cssVar": "--status-danger",      "tailwind": "bg-status-danger / border-status-danger", "light": "#e0434f", "dark": "#ff6b7f", "status": "new", "contrast": { "light-vs-card": 4.13, "light-vs-bg": 3.64, "dark-vs-card": 4.89 } },
        "fg":    { "cssVar": "--status-danger-fg",   "tailwind": "text-status-danger-fg", "light": "#c62a44", "dark": "#ff8a9a", "status": "new", "contrast": { "light-card": 5.50, "light-bg": 4.85, "light-soft": 4.57, "dark-card": 5.97, "dark-bg": 6.92, "dark-soft": 4.92 } },
        "soft":  { "cssVar": "--status-danger-soft", "tailwind": "bg-status-danger-soft", "light": "#fbe5e6", "dark": "#46345b", "status": "new" }
      },
      "warn": {
        "meaning": "降級／熔斷／過時，系統還在跑",
        "solid": { "cssVar": "--status-warn",      "tailwind": "bg-status-warn / border-status-warn", "light": "#b07800", "dark": "#e9a520", "status": "new", "contrast": { "light-vs-card": 3.80, "light-vs-bg": 3.34, "dark-vs-card": 6.30 } },
        "fg":    { "cssVar": "--status-warn-fg",   "tailwind": "text-status-warn-fg", "light": "#8a5300", "dark": "#ffc76b", "status": "new", "contrast": { "light-card": 6.33, "light-bg": 5.57, "light-soft": 5.70, "dark-card": 8.70, "dark-bg": 10.09, "dark-soft": 6.83 } },
        "soft":  { "cssVar": "--status-warn-soft", "tailwind": "bg-status-warn-soft", "light": "#fcf2e0", "dark": "#433c4e", "status": "new" }
      },
      "ok": {
        "meaning": "運作中、剛成功",
        "solid": { "cssVar": "--status-ok",      "tailwind": "bg-status-ok / border-status-ok", "light": "#1a9a74", "dark": "#2cb68a", "status": "new", "contrast": { "light-vs-card": 3.55, "light-vs-bg": 3.12, "dark-vs-card": 5.21 } },
        "fg":    { "cssVar": "--status-ok-fg",   "tailwind": "text-status-ok-fg", "light": "#0f7a5a", "dark": "#5fdcae", "status": "new", "contrast": { "light-card": 5.31, "light-bg": 4.68, "light-soft": 4.68, "dark-card": 7.87, "dark-bg": 9.13, "dark-soft": 6.37 } },
        "soft":  { "cssVar": "--status-ok-soft", "tailwind": "bg-status-ok-soft", "light": "#e1f5ef", "dark": "#293e5c", "status": "new" }
      },
      "idle": {
        "meaning": "閒置、已結束、未知",
        "solid": { "cssVar": "--status-idle",      "tailwind": "bg-status-idle / border-status-idle", "light": "#7a7fa8", "dark": "#7d82b0", "status": "new", "contrast": { "light-vs-card": 3.87, "light-vs-bg": 3.41, "dark-vs-card": 3.63 } },
        "fg":    { "cssVar": "--status-idle-fg",   "tailwind": "text-status-idle-fg", "light": "#565b82", "dark": "#aeb2dc", "status": "new", "note": "= muted-foreground", "contrast": { "light-card": 6.53, "dark-card": 6.51 } },
        "soft":  { "cssVar": "--status-idle-soft", "tailwind": "bg-status-idle-soft", "light": "#efeff5", "dark": "#343762", "status": "new" }
      },
      "info": {
        "meaning": "中性事件、規劃中",
        "solid": { "cssVar": "--status-info",      "tailwind": "bg-status-info / border-status-info", "light": "#7b5cff", "dark": "#7b5cff", "status": "new", "contrast": { "light-vs-card": 4.36, "dark-vs-card": 3.07 } },
        "fg":    { "cssVar": "--status-info-fg",   "tailwind": "text-status-info-fg", "light": "#5b3fd9", "dark": "#b9a8ff", "status": "new", "contrast": { "light-card": 6.65, "dark-card": 6.45 } },
        "soft":  { "cssVar": "--status-info-soft", "tailwind": "bg-status-info-soft", "light": "#ede8ff", "dark": "#34326d", "status": "new" }
      }
    },
    "gradient": {
      "note": "只給 SummaryTile；亮暗共用；白字對 from（較亮端）≥ 4.5:1，裝飾圖示 opacity 0.12 疊上後仍 ≥ 4.5",
      "grad-blue":   { "cssVar": ["--grad-blue-from", "--grad-blue-to"],     "value": ["#4169e1", "#2c47b8"], "status": "keep", "use": "保留（新規則未使用，可給未來非狀態指標）", "white-contrast": 4.85 },
      "grad-violet": { "cssVar": ["--grad-violet-from", "--grad-violet-to"], "value": ["#6a4cf0", "#4a2fc0"], "status": "keep", "use": "SummaryTile brand（今日花費）", "white-contrast": 5.38 },
      "grad-coral":  { "cssVar": ["--grad-coral-from", "--grad-coral-to"],   "value": ["#d6344d", "#a8243f"], "status": "keep", "use": "SummaryTile danger；新增別名 --grad-danger-from/to", "white-contrast": 4.71 },
      "grad-ok":     { "cssVar": ["--grad-ok-from", "--grad-ok-to"],         "value": ["#157f5f", "#0e6b50"], "status": "new",  "use": "SummaryTile ok（進行中任務 > 0）", "white-contrast": 4.96 },
      "grad-warn":   { "cssVar": ["--grad-warn-from", "--grad-warn-to"],     "value": ["#a05f00", "#7a4400"], "status": "new",  "use": "SummaryTile warn（熔斷與額度）", "white-contrast": 5.08 }
    },
    "terminal": {
      "terminal-bg":     { "cssVar": "--terminal-bg",     "light": "#0b0b10", "dark": "#0b0b10", "status": "new", "note": "取代 bg-zinc-950；不跟主題" },
      "terminal-chrome": { "cssVar": "--terminal-chrome", "light": "#17171f", "dark": "#17171f", "status": "new", "note": "pane 標題列，取代 bg-zinc-900" },
      "terminal-line":   { "cssVar": "--terminal-line",   "light": "#26262f", "dark": "#26262f", "status": "new", "note": "取代 border-zinc-800" },
      "terminal-fg":     { "cssVar": "--terminal-fg",     "light": "#e4e4e7", "dark": "#e4e4e7", "status": "new", "note": "取代 text-zinc-200；ANSI 色不動" },
      "terminal-dim":    { "cssVar": "--terminal-dim",    "light": "#8b8b96", "dark": "#8b8b96", "status": "new", "note": "取代 text-zinc-500（對 terminal-bg 5.83:1、對 chrome 5.29:1）" }
    },
    "chart": {
      "note": "類別色盤維持 features/trends/palette.ts 的 SERIES_COLORS（已過 dataviz validator），--chart-1..5 不動；格線用 --border、軸字 muted-foreground",
      "chart-1": { "light": "#3d8fe0", "dark": "#4290e2", "status": "keep" },
      "chart-2": { "light": "#2cb68a", "dark": "#1a9e74", "status": "keep" },
      "chart-3": { "light": "#e9a520", "dark": "#c4880f", "status": "keep" },
      "chart-4": { "light": "#7a6ad8", "dark": "#8a7ce6", "status": "keep" },
      "chart-5": { "light": "#f0804f", "dark": "#dc6a3c", "status": "keep" }
    },
    "tailwind-palette-overrides": {
      "status": "deprecated",
      "note": "index.css 第二個 @theme 裡 emerald/red/amber/sky/orange/yellow/violet 的覆寫，元件全部改用 status-* 後刪除；在那之前保留，避免沒換到的元件掉色"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "cssVar": "--font-sans", "value": "'Nunito Variable', 'Huninn', sans-serif", "tailwind": "font-sans", "status": "keep" },
      "heading": { "cssVar": "--font-heading", "value": "var(--font-sans)", "tailwind": "font-heading", "status": "keep" },
      "mono": { "value": "Tailwind 預設 ui-monospace 堆疊", "tailwind": "font-mono", "status": "keep", "use": "hash、資料夾、分支、時間戳、終端" }
    },
    "scale": [
      { "token": "display",    "tailwind": "text-3xl font-extrabold tabular-nums", "size": 30, "lineHeight": 36, "weight": 800, "use": "SummaryTile 數值（≥ sm）" },
      { "token": "title-lg",   "tailwind": "text-2xl font-extrabold",              "size": 24, "lineHeight": 32, "weight": 800, "use": "PageHeader 標題（內容頁 h1）、SummaryTile 數值（< sm）" },
      { "token": "title-md",   "tailwind": "text-lg font-extrabold",               "size": 18, "lineHeight": 28, "weight": 800, "use": "PageHeader compact 標題（工具頁 h1）、區段標題（h2，如「閒置專案」）" },
      { "token": "title-sm",   "tailwind": "text-base font-bold",                  "size": 16, "lineHeight": 24, "weight": 700, "use": "CardTitle、ActivityRail 標題、EmptyState 標題" },
      { "token": "body",       "tailwind": "text-sm",                              "size": 14, "lineHeight": 20, "weight": 400, "use": "正文、表格儲存格、清單" },
      { "token": "body-strong","tailwind": "text-sm font-semibold",                "size": 14, "lineHeight": 20, "weight": 600, "use": "列主名稱、按鈕、導覽、SummaryTile 標籤（加 font-bold）" },
      { "token": "caption",    "tailwind": "text-xs font-medium",                  "size": 12, "lineHeight": 16, "weight": 500, "use": "meta、時間、副行、StatusPill（加 font-semibold）、表頭（加 font-bold）" },
      { "token": "micro",      "tailwind": "text-2xs font-semibold",               "size": 11, "lineHeight": 16, "weight": 600, "use": "Tag、計數、herdr pane 標題列、縮圖終端字；全站最小字級", "status": "new", "cssVar": "--text-2xs" },
      { "token": "mono-sm",    "tailwind": "font-mono text-xs",                    "size": 12, "lineHeight": 16, "weight": 400, "use": "hash、dir、時間戳" },
      { "token": "mono-2xs",   "tailwind": "font-mono text-2xs",                   "size": 11, "lineHeight": 16, "weight": 400, "use": "縮圖終端（取代 text-[9px]）" }
    ],
    "banned": ["text-[9px]", "text-[11px]", "text-[0.65rem]", "text-[0.7rem]", "text-[0.8rem]", "font-medium 當標題（標題一律 bold/extrabold）"],
    "replacements": {
      "text-[9px]": "font-mono text-2xs（PaneThumbs）",
      "text-[11px]": "text-2xs（CostTables 檔位 Tag → Tag 元件）；GitPage 唯讀說明搬到 PageHeader 副標 text-sm",
      "text-[0.65rem]": "StatusPill size=sm（text-2xs）",
      "text-[0.7rem]": "text-2xs",
      "text-[0.8rem]": "text-sm（Button sm）"
    }
  },
  "spacing": {
    "base": "Tailwind 4px 刻度（--spacing: 0.25rem），不新增刻度；以下是語意別名，寫成 class",
    "page-x":       { "tailwind": "px-4 lg:px-6", "px": "16 / 24" },
    "page-y":       { "tailwind": "py-6",         "px": 24 },
    "section-gap":  { "tailwind": "gap-6",        "px": 24, "use": "頁首與區塊、區塊與區塊" },
    "grid-gap":     { "tailwind": "gap-4",        "px": 16, "use": "卡片格、摘要卡列" },
    "card-pad":     { "tailwind": "p-5",          "px": 20, "use": "Card 預設（取代 --card-spacing 16）", "status": "changed" },
    "card-pad-sm":  { "tailwind": "p-4",          "px": 16, "use": "Card size=sm、SummaryTile 手機" },
    "card-gap":     { "tailwind": "gap-4",        "px": 16, "use": "卡片內 header 與內容" },
    "inner-pad":    { "tailwind": "p-3",          "px": 12, "use": "TaskRow、波次列、Banner" },
    "tool-gutter":  { "tailwind": "p-3 gap-3",    "px": 12, "use": "工具頁外框與窗格間" },
    "stack-sm":     { "tailwind": "gap-2",        "px": 8,  "use": "列內元素、膠囊群" },
    "stack-xs":     { "tailwind": "gap-1.5",      "px": 6,  "use": "圖示＋文字" },
    "cell-x":       { "tailwind": "px-3",         "px": 12, "use": "表格儲存格" }
  },
  "size": {
    "topbar-h":       { "cssVar": "--topbar-h", "value": "3.5rem", "px": 56, "status": "changed", "note": "現在由 ResizeObserver 寫入（約 44 且會換行）；改為 ≥ lg 固定 h-14，< lg 兩列時仍由 ResizeObserver 覆寫" },
    "control-sm":     { "tailwind": "h-7", "px": 28 },
    "control":        { "tailwind": "h-8", "px": 32 },
    "control-lg":     { "tailwind": "h-9", "px": 36, "use": "SegmentedControl 外框" },
    "pill":           { "tailwind": "h-6", "px": 24 },
    "pill-sm":        { "tailwind": "h-5", "px": 20 },
    "row":            { "tailwind": "h-11", "px": 44, "use": "表格列、IdleProjectRow" },
    "row-dense":      { "tailwind": "h-9", "px": 36, "use": "Table dense、commit 列、金額清單" },
    "list-item":      { "tailwind": "min-h-10", "px": 40, "use": "SidebarList 單行項目" },
    "pane-header":    { "tailwind": "h-10", "px": 40 },
    "avatar":         { "tailwind": "size-9", "px": 36, "note": "ActivityItem；compact 用 size-6" },
    "icon-block":     { "tailwind": "size-10", "px": 40, "use": "PageHeader 圖示塊" },
    "icon":           { "tailwind": "size-4", "px": 16, "note": "行內；按鈕 icon-only 用 size-4 置於 size-8 按鈕" },
    "chart-h-sm":     { "cssVar": "--chart-h-sm", "value": "11rem", "px": 176, "status": "new" },
    "chart-h-md":     { "cssVar": "--chart-h-md", "value": "14rem", "px": 224, "status": "new" },
    "chart-h-lg":     { "cssVar": "--chart-h-lg", "value": "16rem", "px": 256, "status": "new" },
    "chart-empty-min":{ "tailwind": "min-h-36", "px": 144, "use": "ChartCard empty 整卡最小高" }
  },
  "radius": {
    "base": { "cssVar": "--radius", "value": "0.875rem", "px": 14, "status": "keep" },
    "allowed": {
      "rounded-full": { "px": "9999", "use": "StatusPill、Tag、Button、SegmentedControl、導覽、頭像、點、進度條、icon button" },
      "rounded-xl":   { "px": 19.6, "use": "表層：Card、Pane、SummaryTile、Banner、ActivityRail、Popover／HoverCard、Sheet" },
      "rounded-lg":   { "px": 14,   "use": "內層：TaskRow、波次列、SidebarList 項、IdleProjectRow、ActivityItem hover 底、Field（input/select）、Tooltip、圖示塊、Skeleton" },
      "rounded-md":   { "px": 11.2, "use": "最小件：code chip、kbd、縮圖終端框" }
    },
    "banned": ["rounded（4px）", "rounded-sm", "rounded-2xl", "rounded-3xl", "rounded-4xl", "rounded-[*]", "rounded-t/b/l 單邊（改由父層 overflow-hidden 裁）"],
    "replacements": {
      "Badge rounded-4xl": "rounded-full（改用 Tag）",
      "Button rounded-lg / rounded-[min(...)]": "rounded-full",
      "Tabs rounded-lg/md": "SegmentedControl（rounded-full）",
      "chart legend rounded-[2px]/[3px]": "rounded-full size-2.5",
      "Count rounded": "Tag rounded-full",
      "git ProjectTab rounded-md": "SidebarList 項 rounded-lg",
      "WaveRow rounded-lg border": "rounded-lg bg-muted（無框）"
    }
  },
  "shadow": {
    "shadow-soft": { "cssVar": "--shadow-soft", "value": "0 6px 20px -10px var(--soft-shadow), 0 1px 3px -1px var(--soft-shadow)", "status": "keep", "use": "Card、Pane、TopBar、ActivityRail、SegmentedControl 選中項" },
    "shadow-pop":  { "cssVar": "--shadow-pop",  "value": "0 14px 30px -14px var(--soft-shadow), 0 2px 6px -2px var(--soft-shadow)", "status": "keep", "use": "SummaryTile、Popover／HoverCard／Tooltip、可點卡 hover" },
    "none":        { "use": "卡片內的內層元素（TaskRow 現在的 shadow-soft 拿掉，靠 bg-muted 區分）" },
    "focus":       { "tailwind": "focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none", "use": "所有可互動元素；漸層卡上改 ring-white/70" }
  },
  "motion": {
    "colors":    { "tailwind": "transition-colors duration-150" },
    "lift":      { "tailwind": "transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-pop", "use": "可點的 SummaryTile、ProjectCard 標題列不用" },
    "pulse":     { "tailwind": "animate-pulse", "use": "working／blocked 狀態點" },
    "reduced":   { "tailwind": "motion-reduce:transition-none motion-reduce:animate-none motion-reduce:hover:translate-y-0" }
  },
  "layout": {
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536, "mobile-ref": 390, "note": "Tailwind 預設，不改" },
    "container-page": { "cssVar": "--container-page", "value": "96rem", "px": 1536, "tailwind": "max-w-page", "status": "new", "note": "放在 @theme（--container-* 命名空間）即生成 max-w-page；與 max-w-screen-2xl 同值；四個內容頁與 TopBar 內容共用" },
    "rail-w":    { "cssVar": "--rail-w",    "value": "20rem",   "px": 320, "status": "new", "use": "總覽活動欄" },
    "aside-w":   { "cssVar": "--aside-w",   "value": "22.5rem", "px": 360, "status": "new", "use": "任務頁 ≥ xl 右欄" },
    "sidebar-w": { "cssVar": "--sidebar-w", "value": "16rem / xl:18rem", "px": "256 / 288", "status": "new", "use": "工具頁左欄" },
    "detail-w":  { "cssVar": "--detail-w",  "value": "22rem / xl:26rem", "px": "352 / 416", "status": "new", "use": "git commit 詳情欄" },
    "skeletons": {
      "content": "mx-auto w-full max-w-page px-4 lg:px-6 py-6 flex flex-col gap-6",
      "tool": "flex h-[calc(100svh-var(--topbar-h))] flex-col gap-3 p-3 （< lg：h-auto）"
    },
    "grids": {
